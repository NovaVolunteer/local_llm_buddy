# Pinecone (required)
PINECONE_API_KEY=your api key goes here
PINECONE_INDEX_NAME=mntgtranscripts
PINECONE_ENVIRONMENT=us-east-1

# Ollama (defaults work for a local Ollama installation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Embedding vector dimension – must match what OLLAMA_EMBED_MODEL produces
# nomic-embed-text  → 768
# mxbai-embed-large → 1024
EMBED_DIMENSION=768

# Text chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Number of chunks to retrieve per query
RETRIEVER_K=4

# LLM sampling temperature (0 = deterministic, higher = more creative)
LLM_TEMPERATURE=0
